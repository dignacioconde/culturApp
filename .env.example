# Orquestación multi-modelo — copia a `.env` en la raíz del checkout principal
# (la carpeta que contiene `.git`; la comparten todos los worktrees) y rellena solo lo que uses.
# `.env` está en .gitignore. Vite solo expone variables VITE_*, así que estas
# claves nunca llegan al bundle del cliente. La config de Supabase de la app
# sigue en `.env.local` (ver README.md).
#
# NUNCA pongas aquí tokens de suscripción de Claude o ChatGPT: esos solo los
# usan las CLIs oficiales `claude` y `codex` con su propio login.

# --- Obreros baratos (API key propia) -------------------------------------
# Nombres de variable verificados con `opencode models --standalone` (OpenCode 2.2.1).
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Alibaba Model Studio / DashScope (Qwen). Activa los proveedores alibaba y alibaba-cn.
DASHSCOPE_API_KEY=
# Z.ai / Zhipu (GLM). Activa los proveedores zai y zhipuai.
ZHIPU_API_KEY=

# --- Ollama (local, último recurso) ----------------------------------------
# Solo informativo para los checks del worker; OpenCode detecta Ollama en el puerto por defecto.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- cheap-worker ------------------------------------------------------------
# Reintentos por modelo cuando falla la verificación (por defecto: config/models.yaml).
WORKER_MAX_RETRIES=2
# Timeout por intento en segundos si la llamada no lo indica.
WORKER_DEFAULT_TIMEOUT_S=900
